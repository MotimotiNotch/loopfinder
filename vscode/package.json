{
  "name": "loopfinder",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.1",
  "publisher": "motimotinotch",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MotimotiNotch/loopfinder"
  },
  "sponsor": {
    "url": "https://ko-fi.com/motimotinotch"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "keywords": [
    "feedback-loop",
    "data-flow",
    "workspace",
    "tracing",
    "obsidian"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In a workspace you have not trusted, loopfinder only shows a graph that is already built. Init and build are off: building runs the workspace's scripts.",
      "restrictedConfigurations": [
        "loopfinder.allowNetwork",
        "loopfinder.allowSubprocess"
      ]
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "loopfinder.show",
        "title": "%command.show%",
        "category": "loopfinder"
      },
      {
        "command": "loopfinder.build",
        "title": "%command.build%",
        "category": "loopfinder",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "loopfinder.init",
        "title": "%command.init%",
        "category": "loopfinder",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "loopfinder.copyPrompt",
        "title": "%command.copyPrompt%",
        "category": "loopfinder"
      }
    ],
    "configuration": {
      "title": "loopfinder",
      "properties": {
        "loopfinder.allowNetwork": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.allowNetwork%"
        },
        "loopfinder.allowSubprocess": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.allowSubprocess%"
        },
        "loopfinder.layoutBudget": {
          "type": "number",
          "default": 15,
          "minimum": 0,
          "markdownDescription": "%config.layoutBudget%"
        }
      }
    }
  },
  "scripts": {
    "prepare-core": "node scripts/prepare.js",
    "package": "node scripts/prepare.js && npx @vscode/vsce package --no-dependencies"
  },
  "icon": "icon.png",
  "categories": [
    "Visualization",
    "Other"
  ],
  "l10n": "./l10n"
}
